# 最小化 LLM 网关的环境变量示例。上游 API key 的变量名要和 config.json 里 providers.<name>.api_key_env 对得上。
UPSTREAM_A_KEY=
UPSTREAM_B_KEY=

# 首字节保活（防反代 120s 超时）：上游超过 GATEWAY_HOLD_MS 还没吐数据，就先开流并每 GATEWAY_KA_MS 发一个注释心跳。0 = 关闭。
GATEWAY_HOLD_MS=60000
GATEWAY_KA_MS=10000

# 上游空闲看门狗：连续这么久收不到任何字节就掐掉上游（防「TCP 连上了但不回数据」永久挂起）。
# 默认 600000（10 分钟）；流式每收到一块就重置。0 = 关闭。
GATEWAY_UP_IDLE_MS=600000

# 请求体硬上限（MB）。默认 64；超了直接 413，面板接口还额外拒绝 chunked（411）。
# 带 base64 图片的请求会比较大，按自己的客户端调。
GATEWAY_MAX_BODY_MB=64

# 无主（没配 owner）的旧网关 key 是否允许当面板管理员——**默认关闭**。
# 开着时也只对「本机直连」生效（TCP 对端是 loopback 或容器默认网关）。
# 只有本机脚本要用旧 key 调 /api/* 时才设成 1；面板本身请用账号登录。
GATEWAY_LEGACY_KEY_ADMIN=0

# 可选：上游额度卡片用的 key（对应 config.json 的 quota.*.api_key_env）

# 联网搜索代理（对应 config.json 的 web_search.api_key_env）；不开代理就留空
SEARCH_API_KEY=
